#version 460

// How bright the frame is, as a histogram of log luminance.
//
// A histogram rather than a running average because of what an interior looks like: thirteen tiny
// flames at a luminance of one in a room sitting at three hundredths of that. A mean is dragged
// around by whichever of those two populations has more pixels; a histogram keeps them apart and
// lets the reduction that follows decide what to expose for.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D source;
layout(set = 0, binding = 1) buffer Histogram {
    uint bins[];
};

layout(push_constant) uniform Range {
    // Darkest log2 luminance the histogram resolves, and one over its span in stops.
    float min_log_luminance;
    float inverse_log_range;
} range;

// Matches `BIN_COUNT` in `auto_exposure.rs`, which sizes the buffer this writes into.
const uint BINS = 256u;

// Rec. 709 luminance, matching the primaries the textures were decoded from.
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

// Below this a pixel is counted as black rather than binned. Without it the vast dark areas of an
// interior pile into the lowest bin and drag the average down to meet them, and the exposure opens
// until the few lit surfaces are white.
const float BLACK = 0.0001;

// A workgroup's own tally, so 256 pixels contend for shared memory rather than for one global
// atomic each. The global buffer sees one atomic per bin per workgroup instead of one per pixel.
shared uint local_bins[BINS];

uint bin_of(float luminance) {
    if (luminance < BLACK) {
        return 0u;
    }
    // Bin zero is reserved for black, so the resolved range starts at one.
    float normalised = (log2(luminance) - range.min_log_luminance) * range.inverse_log_range;
    return uint(clamp(normalised, 0.0, 1.0) * float(BINS - 2u)) + 1u;
}

void main() {
    local_bins[gl_LocalInvocationIndex] = 0u;
    barrier();

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(pixel, imageSize(source)))) {
        float luminance = dot(imageLoad(source, pixel).rgb, LUMA);
        atomicAdd(local_bins[bin_of(luminance)], 1u);
    }
    barrier();

    // One global atomic per bin per workgroup, and none at all for bins this tile never touched.
    uint count = local_bins[gl_LocalInvocationIndex];
    if (count > 0u) {
        atomicAdd(bins[gl_LocalInvocationIndex], count);
    }
}
