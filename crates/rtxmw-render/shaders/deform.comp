#version 460
#extension GL_EXT_scalar_block_layout : require

// Rewrites one placement's vertices, ahead of the acceleration structure built over them.
//
// **A stand-in for skinning, and the same shape as it.** What lands here eventually is a bone
// matrix per vertex weight; what is here now is one sine along the source's own x, which is enough
// to make every part of the per-frame path real — the vertices genuinely move, the bottom level
// genuinely has to be rebuilt over them, and the picture genuinely changes. `docs/design.md` §M12
// says why that comes before the content rather than after it.
//
// Source and destination are the same two buffers at different offsets: a deforming placement takes
// a slice of the shared streams of its own — see `GeometryBuffers::reserve_deformed` — so the bind
// pose stays where it was uploaded and nothing else in the renderer learns a new address.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, scalar) buffer Positions {
    float positions[];
};

struct Attributes {
    vec3 normal;
    vec2 uv;
};

layout(set = 0, binding = 1, scalar) buffer VertexAttributes {
    Attributes attributes[];
};

layout(push_constant, scalar) uniform Push {
    // First vertex of the pose being read, and of the region being written.
    uint source;
    uint destination;
    uint count;
    // Seconds, and how far this placement is offset in the cycle so a row of them does not move as
    // one body.
    float time;
    float phase;
    // How far a vertex travels at most, in world units, and how many waves span one unit of x.
    float amplitude;
    float wavenumber;
} push;

vec3 position_at(uint vertex) {
    uint base = vertex * 3u;
    return vec3(positions[base], positions[base + 1u], positions[base + 2u]);
}

void store_position(uint vertex, vec3 value) {
    uint base = vertex * 3u;
    positions[base] = value.x;
    positions[base + 1u] = value.y;
    positions[base + 2u] = value.z;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= push.count) {
        return;
    }
    vec3 pose = position_at(push.source + index);
    Attributes shading = attributes[push.source + index];
    vec3 facing = normalize(shading.normal);

    // **Along the normal**, so the movement is off the surface whichever way the mesh was authored
    // — a displacement down a fixed axis is invisible on any surface that happens to contain it.
    float angle = push.wavenumber * pose.x + push.time + push.phase;
    vec3 moved = pose + facing * (push.amplitude * sin(angle));

    // The normal the displacement implies, which is what makes this a deformation rather than a
    // wobble the lighting never sees: the surface gained the derivative of the sine along its own
    // x, so the normal leans back by that slope.
    vec3 along = vec3(1.0, 0.0, 0.0);
    along -= facing * dot(facing, along);
    float span = dot(along, along);
    vec3 normal = facing;
    if (span > 1.0e-6) {
        float slope = push.amplitude * push.wavenumber * cos(angle);
        normal = normalize(facing - along * (slope * inversesqrt(span)));
    }

    store_position(push.destination + index, moved);
    attributes[push.destination + index] = Attributes(normal, shading.uv);
}
