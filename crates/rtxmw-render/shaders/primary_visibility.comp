#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// Primary visibility by inline ray query, with one diffuse bounce of indirect light.
//
// Ray queries in a compute shader rather than a ray tracing pipeline: there is one material path
// and no recursion here, so a shader binding table would buy nothing. The output goes to a storage
// image because a Vulkan swapchain image cannot be one — sRGB formats expose no storage capability,
// so the frame reaches the screen through a later blit.

// The pass is assembled from these, in an order the dependencies decide: nothing here may
// reference a name a later include defines, with the one exception `lighting.glsl` declares.

#include "bindings.glsl"
#include "sampling.glsl"
#include "relief.glsl"
#include "surface.glsl"
#include "lighting.glsl"
#include "waves.glsl"
#include "water.glsl"
#include "fog.glsl"
#include "lightning.glsl"
#include "wetness.glsl"
#include "precipitation.glsl"

// Where the surface at `ndc` was on the previous frame's screen, as a displacement in pixels.
//
// Add it to a pixel's coordinate to find the history that belongs to it. Reprojected as an *offset
// from the eye* throughout: `direction * t` is that offset already, computed without ever forming a
// world position, and stepping it back by the frame's camera motion lands it in the previous
// frame's camera space, where that frame's own projection finishes the job. Building the world
// point and differencing it against the old eye would cost the precision `§8.7` is about.
//
// Zero for a miss — a temporal filter reads that as "this pixel did not move", which for the sky is
// true — and zero behind the previous eye, where there is no screen position at all and the divide
// would fold the point back into the frame as a plausible-looking coordinate.
vec2 motion_vector(Surface surface, vec3 direction, vec2 ndc, uvec2 size) {
    if (!surface.hit) {
        return vec2(0.0);
    }
    vec3 was = direction * surface.t + frame.camera_motion;
    vec4 before = frame.previous_clip_from_offset * vec4(was, 1.0);
    if (before.w <= 0.0) {
        return vec2(0.0);
    }
    return (before.xy / before.w - ndc) * 0.5 * vec2(size);
}

layout(local_size_x = 8, local_size_y = 8) in;

// What an emissive of one is worth, as light.
//
// **The original's scale is not this renderer's.** There a fully lit surface reached one and an
// emissive of one matched it; here direct sun is `DAYLIGHT` and the sky about a fifth of that, so
// the same number has to be carried across or a glow that read as bright becomes a rounding error.
// Matched to the sky rather than to the sun: what these materials are for is being visible in
// shade, and a mushroom is not as bright as the sun on it.
const float EMISSIVE_INTENSITY = 1.6;

void main() {
    // Unsigned, because the hash streams index by it and only `imageSize` and `imageStore` want it
    // signed. Carrying both would mean two names for one coordinate.
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 size = uvec2(imageSize(target));
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    // Unproject the pixel centre onto the near plane, which the matrix gives *relative to the eye*
    // — see `ndc_to_world_offset`. Subtracting the camera position from a world-space near point
    // instead is a difference of two numbers the size of the world, and it cost 116 pixels of aim
    // at Seyda Neen.
    //
    // The projection is reverse-Z, so the near plane is depth 1 and the far plane is depth 0. The
    // far plane is also at infinity, where w collapses to zero — so the near plane is the only one
    // that can be unprojected at all.
    // The jitter moves the point inside the pixel that the ray goes through, so successive frames
    // sample different places in it. **It does not need taking back out for the motion vector**: the
    // jitter is applied to the coordinate and not to the matrix, so projecting the hit back through
    // that same matrix returns this exact `ndc`, and a vector measured against it is the surface's
    // own screen motion with the jitter already cancelled. Measuring against the pixel centre
    // instead would report the jitter itself as motion every time the camera stood still.
    vec2 ndc = ((vec2(pixel) + 0.5 + frame.jitter) / vec2(size)) * 2.0 - 1.0;
    vec4 near_point = frame.ndc_to_world_offset * vec4(ndc, 1.0, 1.0);
    vec3 direction = normalize(near_point.xyz / near_point.w);

    Surface surface = trace(frame.camera_position, direction, 0.0, frame.cone_spread, MASK_ANY);

    // A miss contributes only the sky, and writes zeroes across the G-buffer rather than leaving
    // it alone. That is not tidiness: the filter reads a neighbourhood, and an untouched pixel
    // holds whatever the last frame or the allocator left there. A zero depth is the flag it tests,
    // since a real hit is always at least `RAY_MIN` away.
    vec3 emitted = sky(direction);
    vec3 lighting = vec3(0.0);
    // Nothing in vanilla Morrowind is specular but its water — until it rains, and then everything
    // the sky can see is, which is what `wetness.glsl` is for. Dry is still the answer for most of
    // the world most of the time.
    Guides guides = matte();
    float wet = 0.0;
    Film film = Film(1.0, vec3(0.0));
    if (surface.water) {
        // Written whole to the output rather than through the G-buffer: there is no albedo to
        // demodulate by, and nothing noisy for the filter to improve.
        emitted = water_shade(surface, direction, pixel, guides);
    } else if (surface.hit) {
        // Nothing of the sky reaches a surface directly, and `emitted` started as the sky.
        emitted = vec3(0.0);
        // **Emissive is a lighting term, not a colour beside one.** The original engine sums it
        // with the diffuse and ambient light and multiplies the whole by the texture —
        // `objects.frag:232` and `:236` in OpenMW. Adding it past the albedo instead is why a
        // Bitter Coast mushroom cap, whose material carries 0.5 against the stalk's zero, came out
        // flat white with no texture in it. Scaled because the original's `1.0` means "as bright as
        // a fully lit surface" in a renderer whose light never exceeded one, and here it does.
        lighting = surface.emissive * EMISSIVE_INTENSITY
                 + gather_indirect(surface, pixel)
                 + direct_light(surface, pixel, STREAM_DIRECT, SHADOW_SAMPLES);
        // **The half of a shower that is not in the air.** What the rain lands on goes darker under
        // the film it leaves and picks the sky up off the top of it, and the sheen belongs here
        // rather than behind the albedo for the same reason the water's reflection does: it is
        // light the surface returned without its colour ever touching it.
        wet = wetness(surface, pixel);
        film = filmed(surface, direction, wet, pixel, guides);
        emitted += film.reflected;
    }
    // Under the surface, everything the ray crossed to get here was water. The albedo is dimmed
    // rather than the lighting, because the filter divides the lighting by it and multiplying both
    // would put the water back — and what the depth took is a property of the path, not of the
    // light that travelled it.
    vec3 albedo = soaked(surface.albedo, wet) * film.kept;
    if (frame.water_level - frame.camera_position.z > 0.0) {
        float path = surface.hit ? surface.t : WATER_MAX_PATH;
        emitted = absorbed_by_water(emitted, path);
        albedo *= exp(-WATER_EXTINCTION * path);
    }

    // **The sky is not a black surface, it is no surface**, and the two have to be told apart in the
    // guides. A miss leaves nothing to demodulate by, so the natural thing to write is zero — but a
    // zero albedo tells an upscaler "this pixel reflects nothing", and a zero normal is not a unit
    // vector at all. Ray Reconstruction's integration guide asks for mid grey and calls the
    // alternative a common integration error; the normal it wants normalized, so a miss faces the
    // camera. Water is the same case for the same reason: it is shaded whole into `emitted`, with no
    // albedo the composite could put back.
    //
    // **The frame does not change.** The composite adds `albedo * lighting`, and lighting is zero on
    // both of these paths, so what is written here is read by the upscaler and by nothing else.
    vec3 guide_albedo = albedo;
    vec3 guide_normal = surface.interpolated;
    if (!surface.hit || surface.water) {
        guide_albedo = vec3(SKY_GUIDE_ALBEDO);
        guide_normal = -direction;
    }

    // **Both halves, because fog dims the frame rather than one term of it.** The composite adds
    // them back together, so attenuating each and putting the scattered light in the first is the
    // same as fogging the sum — and it is done here because this is where the lights are.
    vec4 fog = fog_along(frame.camera_position, direction,
                         surface.hit ? surface.t : FOG_REACH, pixel, !surface.hit);
    emitted = emitted * fog.w + fog.xyz;
    lighting *= fog.w;

    // **Into its own layer rather than into the frame.** What falls is signal and Ray Reconstruction
    // cannot tell — composited here it would be denoised, and accumulated against motion vectors
    // that describe the surface *behind* each streak. `DLSS.TransparencyLayer` is the way the SDK
    // provides out of that: a layer at render resolution which the upscaler composites rather than
    // filters. Premultiplied, with the coverage beside it, because NGX takes the two separately.
    //
    // **In front of the fog, because it is nearer than the fog is thick.** What falls is drawn
    // within the weather's own `Diameter` of the eye — nine metres for rain — where even a
    // thunderstorm's air has taken a sixth of a stop out of the frame, so leaving it out of the
    // march costs nothing an eye could find.
    // **The channel, occluded by what stands in front of it and dimmed by the air between.** Not by
    // `fog.w`, which is the march's full transmittance and at strike range is a cliff rather than a
    // gradient — `bolt_along` carries the same capped haze the light it throws does, so the two
    // cannot drift apart again.
    emitted += bolt_along(frame.camera_position, direction,
                          surface.hit ? surface.t : RAY_MAX);

    // **And the deck the discharge is inside, in front of the fog for the same reason** — see
    // `flash_on_deck`. Only where the ray reaches the sky at all: a headland in front of the cloud
    // hides the cloud, and this is added past the point where anything else would have said so.
    if (!surface.hit) {
        emitted += flash_on_deck(direction, frame.cone_spread);
    }

    vec4 falling = precipitation_along(frame.camera_position, direction,
                                       surface.hit ? surface.t : FOG_REACH);
    imageStore(transparency_target, ivec2(pixel), vec4(falling.xyz, 1.0 - falling.w));
    imageStore(transparency_opacity_target, ivec2(pixel), vec4(1.0 - falling.w));

    imageStore(motion_target, ivec2(pixel), vec4(motion_vector(surface, direction, ndc, size), 0.0, 0.0));

    // The specular distance rides in the alpha, which the composite does not read and which the
    // normal target already sets the precedent for by carrying depth in its own fourth channel.
    imageStore(albedo_target, ivec2(pixel), vec4(guide_albedo, guides.specular_distance));
    // Roughness is not here: it rides in the normal target's fourth channel, which is where the
    // upscaler reads it from and so the only copy worth keeping.
    imageStore(material_target, ivec2(pixel), vec4(guides.specular_albedo, 0.0));
    imageStore(
        normal_roughness_target, ivec2(pixel), vec4(guide_normal, guides.roughness));
    // Clip depth for the upscaler, and the distance from the eye the filter stops edges on. A miss
    // has neither, and zero is what the filter reads as "nothing here".
    float clip_depth = 0.0;
    if (surface.hit) {
        vec4 clipped = frame.clip_from_offset * vec4(direction * surface.t, 1.0);
        clip_depth = clipped.w > 0.0 ? clipped.z / clipped.w : 0.0;
    }
    imageStore(depth_target, ivec2(pixel), vec4(clip_depth, surface.t, 0.0, 0.0));
    imageStore(illumination_target, ivec2(pixel), vec4(lighting, 1.0));
    // Alpha carries whether anything was hit at all. Inferring it from the colour worked while the
    // output was barycentric and every hit was bright, but a material can legitimately be dark —
    // so the flag is written rather than guessed at.
    imageStore(target, ivec2(pixel), vec4(emitted, surface.hit ? 1.0 : 0.0));
}
