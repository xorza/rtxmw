#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require

// Primary visibility by inline ray query.
//
// Ray queries in a compute shader rather than a ray tracing pipeline: there is one material path
// and no recursion here, so a shader binding table would buy nothing. The output goes to a storage
// image because a Vulkan swapchain image cannot be one — sRGB formats expose no storage capability,
// so the frame reaches the screen through a later blit.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;

// One entry per acceleration structure geometry, addressed by the two halves a hit reports.
struct Geometry {
    uint first_index;
    uint first_vertex;
    uint material;
    uint padding;
};

struct Material {
    vec3 diffuse;
    float opacity;
    vec3 emissive;
    float alpha_cutoff;
    uint base_colour;
    uint padding0;
    uint padding1;
    uint padding2;
};

// Scalar layout so these match the host structs field for field. Under the default std430 rules a
// `vec3` would be padded to sixteen bytes and every entry after the first would be misread.
layout(set = 0, binding = 2, scalar) readonly buffer Geometries {
    Geometry geometries[];
};
layout(set = 0, binding = 3, scalar) readonly buffer Materials {
    Material materials[];
};

// 80 bytes. Vulkan only guarantees 128 bytes of push constants, so sending separate inverse view
// and projection matrices (144 with the camera) would work on this GPU and fail the guarantee.
// Their product carries the same information for unprojection.
layout(push_constant) uniform Frame {
    mat4 inverse_view_projection;
    vec3 camera_position;
    uint _pad;
} frame;

// A raytracer has no near plane — that is a rasterization artefact. This is only large enough to
// keep a ray from hitting the surface it starts on, and is deliberately far below the camera's
// near plane so nothing is clipped just for being close.
const float RAY_MIN = 0.01;
// Far enough to cross an exterior cell, which is 8192 world units.
const float RAY_MAX = 1.0e6;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    // Unproject the pixel centre onto the near plane, then aim from the eye through it.
    //
    // The projection is reverse-Z, so the near plane is depth 1 and the far plane is depth 0. The
    // far plane is also at infinity, where w collapses to zero — so the near plane is the only one
    // that can be unprojected at all.
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 target_point = frame.inverse_view_projection * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 direction = normalize(target_point.xyz / target_point.w - frame.camera_position);

    // Every hit is treated as opaque, which skips the any-hit path entirely. Morrowind is full of
    // alpha-tested foliage and grates that need the candidate loop instead, so this has to change
    // once materials exist — until then it would silently draw those as solid rectangles.
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, 0xFF,
                          frame.camera_position, RAY_MIN, direction, RAY_MAX);
    while (rayQueryProceedEXT(query)) {}

    vec3 colour = vec3(0.05, 0.07, 0.10);
    // Alpha carries whether anything was hit at all. Inferring it from the colour worked while the
    // output was barycentric and every hit was bright, but a material can legitimately be dark —
    // so the flag is written rather than guessed at.
    float hit = 0.0;
    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        hit = 1.0;
        // The custom index is where this instance's mesh starts in the flat geometry table, and the
        // geometry index is which of its runs was hit. Their sum is the entry, with no indirection.
        uint slot = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)
                  + rayQueryGetIntersectionGeometryIndexEXT(query, true);
        uint id = geometries[slot].material;
        Material material = materials[id];

        // False colour by material until textures exist. Hashing the index rather than showing the
        // diffuse colour is deliberate: vanilla materials are almost all white, so a diffuse view
        // would be a blank image whether or not the lookup worked.
        vec3 tint = vec3(float((id * 37u) % 255u), float((id * 91u) % 255u),
                         float((id * 151u) % 255u)) / 255.0;
        // Modulated by the material's own diffuse so both tables are genuinely read: a misaligned
        // material buffer shows up as wrong colour rather than being optimised away unnoticed.
        colour = max(tint, vec3(0.08)) * material.diffuse;
    }
    imageStore(target, pixel, vec4(colour, hit));
}
