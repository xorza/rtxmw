#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// Primary visibility by inline ray query.
//
// Ray queries in a compute shader rather than a ray tracing pipeline: there is one material path
// and no recursion here, so a shader binding table would buy nothing. The output goes to a storage
// image because a Vulkan swapchain image cannot be one — sRGB formats expose no storage capability,
// so the frame reaches the screen through a later blit.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;

// One entry per acceleration structure geometry, addressed by the two halves a hit reports.
struct Geometry {
    uint first_index;
    uint first_vertex;
    uint material;
    uint padding;
};

struct Material {
    vec3 diffuse;
    float opacity;
    vec3 emissive;
    float alpha_cutoff;
    uint base_colour;
    uint padding0;
    uint padding1;
    uint padding2;
};

// Scalar layout so these match the host structs field for field. Under the default std430 rules a
// `vec3` would be padded to sixteen bytes and every entry after the first would be misread.
layout(set = 0, binding = 2, scalar) readonly buffer Geometries {
    Geometry geometries[];
};
layout(set = 0, binding = 3, scalar) readonly buffer Materials {
    Material materials[];
};

layout(set = 0, binding = 4, scalar) readonly buffer Indices {
    uint indices[];
};

struct Attributes {
    vec3 normal;
    vec2 uv;
};

layout(set = 0, binding = 5, scalar) readonly buffer VertexAttributes {
    Attributes attributes[];
};

struct Light {
    vec3 position;
    float radius;
    vec3 colour;
    /// How large the emitter is, which is what gives its shadows a penumbra.
    float source_radius;
};

layout(set = 0, binding = 6, scalar) readonly buffer Lights {
    Light lights[];
};

layout(set = 0, binding = 7, scalar) readonly buffer Positions {
    vec3 positions[];
};

// Last binding, and the only runtime-sized one: Vulkan allows a variable descriptor count only on
// the final element of a set. Slot zero is the fallback, so a material's texture id addresses
// `id + 1`.
layout(set = 0, binding = 8) uniform sampler2D textures[];

// Stands in for a material with no base colour texture. Declared as `NO_TEXTURE` in
// `material_buffers.rs` too, and pinned there by a test, because a shader cannot see a Rust
// constant.
const uint NO_TEXTURE = 0xFFFFFFFFu;

// 80 bytes. Vulkan only guarantees 128 bytes of push constants, so sending separate inverse view
// and projection matrices (144 with the camera) would work on this GPU and fail the guarantee.
// Their product carries the same information for unprojection.
layout(push_constant) uniform Frame {
    mat4 inverse_view_projection;
    vec3 camera_position;
    uint light_count;
    vec3 ambient;
    float cone_spread;
} frame;

// A raytracer has no near plane — that is a rasterization artefact. This is only large enough to
// keep a ray from hitting the surface it starts on, and is deliberately far below the camera's
// near plane so nothing is clipped just for being close.
const float RAY_MIN = 0.01;
// Far enough to cross an exterior cell, which is 8192 world units.
const float RAY_MAX = 1.0e6;
// How many shadow rays each light gets. A point light needs one and gives a hard edge; a light
// with real size needs several, and the penumbra is exactly the disagreement between them.
const uint SHADOW_SAMPLES = 8u;

// How far along the normal a shadow ray starts. Morrowind's unit is about 1.4 cm, so this is a
// couple of centimetres — enough to clear the interpolation error on a large triangle without
// letting light leak under a wall.
const float SHADOW_BIAS = 1.5;

// Texture coordinate and object-space normal at a hit, interpolated from the triangle's corners.
//
// Takes the pieces rather than the ray query itself so the candidate loop and the committed hit can
// share it — they read the same values through different accessors.
// The three shared-stream vertex indices of a hit triangle.
//
// `first_index` locates the run inside the shared index buffer and `first_vertex` rebases the
// mesh-local index values onto the shared attribute and position streams — the same two offsets the
// acceleration structure was built with.
uvec3 triangle_vertices(Geometry geom, uint primitive) {
    uint triangle = geom.first_index + 3u * primitive;
    return uvec3(geom.first_vertex + indices[triangle],
                 geom.first_vertex + indices[triangle + 1u],
                 geom.first_vertex + indices[triangle + 2u]);
}

// A hit's three corner weights. Barycentrics come back as the second and third; the first is what
// is left.
vec3 corner_weights(vec2 bary) {
    return vec3(1.0 - bary.x - bary.y, bary.x, bary.y);
}

vec2 interpolate_uv(uvec3 verts, vec3 weights) {
    return attributes[verts.x].uv * weights.x
         + attributes[verts.y].uv * weights.y
         + attributes[verts.z].uv * weights.z;
}

vec3 interpolate_normal(uvec3 verts, vec3 weights) {
    return attributes[verts.x].normal * weights.x
         + attributes[verts.y].normal * weights.y
         + attributes[verts.z].normal * weights.z;
}

// Mip level for a hit, from the ray cone's footprint on the surface.
//
// A rasterizer takes this from screen-space derivatives, which a compute shader does not have, so
// the level is reconstructed instead: the cone one pixel subtends has width `t * spread` at the
// hit, spread further by the angle the surface is seen at, and the mip whose texels match that
// width is the one to sample. Without it every surface samples mip zero, and anything dense or
// grazing turns to static.
//
// This is Akenine-Möller's ray-cone method, minus the curvature term, which needs a second
// derivative the primary ray has no cheap way to get.
float cone_lod(uvec3 verts, mat4x3 to_world, vec3 direction, vec3 world_normal, float t,
               uint texture_slot) {
    // World space throughout. The footprint below is a world-space length, so an object-space area
    // here would be wrong by the instance's scale — silently, and only for scaled instances.
    vec3 p0 = to_world * vec4(positions[verts.x], 1.0);
    vec3 p1 = to_world * vec4(positions[verts.y], 1.0);
    vec3 p2 = to_world * vec4(positions[verts.z], 1.0);
    float world_area = length(cross(p1 - p0, p2 - p0));
    vec2 t0 = attributes[verts.x].uv;
    vec2 t1 = attributes[verts.y].uv;
    vec2 t2 = attributes[verts.z].uv;
    float uv_area = abs((t1.x - t0.x) * (t2.y - t0.y) - (t2.x - t0.x) * (t1.y - t0.y));
    if (world_area <= 0.0 || uv_area <= 0.0) {
        return 0.0;
    }

    // How much of the texture one world unit covers, in texels.
    vec2 size = vec2(textureSize(textures[nonuniformEXT(texture_slot)], 0));
    float texels_per_unit = sqrt(uv_area / world_area) * max(size.x, size.y);

    // Cone footprint, widened as the surface tilts away: at grazing incidence a pixel covers far
    // more surface, which is exactly where the aliasing is worst.
    float footprint = t * frame.cone_spread / max(abs(dot(world_normal, direction)), 0.02);
    return max(0.0, log2(footprint * texels_per_unit));
}

// The material's base colour texel at `uv`.
//
// Slot zero of the array is the fallback, so a material's texture id addresses `id + 1`.
// `nonuniformEXT` because neighbouring rays in a warp land on different materials, and an index
// that varies across the warp is undefined without it.
vec4 base_colour(Material material, vec2 uv, float lod) {
    return textureLod(textures[nonuniformEXT(material.base_colour + 1u)], uv, lod);
}

// Whether a candidate intersection survives its material's alpha cutout.
//
// Only non-opaque geometry reaches this: the build marks a run `OPAQUE` when its material is, and
// traversal then commits without ever asking.
bool alpha_passes(uint slot, uint primitive, vec2 bary) {
    Geometry geom = geometries[slot];
    Material material = materials[geom.material];
    if (material.alpha_cutoff <= 0.0 || material.base_colour == NO_TEXTURE) {
        return true;
    }
    // Only the texture coordinate: this runs per non-opaque candidate, which is the busiest of
    // the three paths, and a normal it would discard costs three more buffer reads each time.
    vec2 uv = interpolate_uv(triangle_vertices(geom, primitive), corner_weights(bary));
    // Level zero for the cutout: a mip average blurs a leaf's edge into partial alpha, and the
    // test would then keep or drop texels the artist put there as fully one or the other.
    float alpha = base_colour(material, uv, 0.0).a;
    return alpha >= material.alpha_cutoff;
}

// A cheap, stable hash of three integers, for decorrelating one pixel's samples from its
// neighbours'.
//
// Stable rather than per-frame: without temporal accumulation, reseeding every frame turns the
// penumbra into crawling noise. A fixed pattern dithers instead, which holds still.
uint hash(uvec3 v) {
    uint h = v.x * 0x8DA6B343u ^ v.y * 0xD8163841u ^ v.z * 0xCB1AB31Fu;
    h ^= h >> 15;
    h *= 0x2C1B3C6Du;
    h ^= h >> 12;
    return h;
}

// A point on the unit sphere, from two values in `0..1`.
vec3 sphere_point(vec2 u) {
    float z = 1.0 - 2.0 * u.x;
    float r = sqrt(max(0.0, 1.0 - z * z));
    float phi = 6.2831853 * u.y;
    return vec3(r * cos(phi), r * sin(phi), z);
}

// Whether anything blocks the segment from `origin` along `dir` within `reach` units.
//
// `TerminateOnFirstHit` because a shadow ray only asks whether *something* is in the way — the
// nearest blocker is no more useful than any other, and stopping at the first is most of why a
// shadow ray is cheaper than a visibility ray.
bool occluded(vec3 origin, vec3 dir, float reach) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                          origin, RAY_MIN, dir, reach);
    // The same candidate loop as the visibility ray in `main`, and it cannot be shared: `glslc`
    // rejects `rayQueryEXT` as an `out` or `inout` parameter, so a traversal cannot be handed to a
    // function. Any change to the cutout here has to be made in both places.
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false)
            == gl_RayQueryCandidateIntersectionTriangleEXT) {
            uint slot = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false)
                      + rayQueryGetIntersectionGeometryIndexEXT(query, false);
            // A cutout casts the shadow of what survives it, not of its bounding quad — a grate
            // has to throw bars rather than a rectangle.
            if (alpha_passes(slot,
                             rayQueryGetIntersectionPrimitiveIndexEXT(query, false),
                             rayQueryGetIntersectionBarycentricsEXT(query, false))) {
                rayQueryConfirmIntersectionEXT(query);
            }
        }
    }
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// How much of a light reaches a point `distance` away.
//
// Inverse square, windowed so the contribution reaches exactly zero at the light's radius rather
// than being clipped there. Morrowind's radius is a hard cutoff in the original engine, and a
// clipped inverse square leaves a visible edge where the falloff jumps to nothing.
float attenuation(float reach, float radius) {
    float ratio = reach / radius;
    float window = clamp(1.0 - ratio * ratio * ratio * ratio, 0.0, 1.0);
    // The `+ 1` keeps the singularity at zero distance finite; a light is not a point in practice.
    return window * window / (reach * reach + 1.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    // Unproject the pixel centre onto the near plane, then aim from the eye through it.
    //
    // The projection is reverse-Z, so the near plane is depth 1 and the far plane is depth 0. The
    // far plane is also at infinity, where w collapses to zero — so the near plane is the only one
    // that can be unprojected at all.
    vec2 screen_uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 target_point = frame.inverse_view_projection * vec4(screen_uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 direction = normalize(target_point.xyz / target_point.w - frame.camera_position);

    // No blanket opacity flag: the per-geometry `OPAQUE` bits the build set from each material are
    // what decide this now. Forcing it here would override them and put the cutout back.
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsNoneEXT, 0xFF,
                          frame.camera_position, RAY_MIN, direction, RAY_MAX);
    // Duplicated in `occluded`, which the language forces — see the note there.
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false)
            == gl_RayQueryCandidateIntersectionTriangleEXT) {
            uint slot = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false)
                      + rayQueryGetIntersectionGeometryIndexEXT(query, false);
            if (alpha_passes(slot,
                             rayQueryGetIntersectionPrimitiveIndexEXT(query, false),
                             rayQueryGetIntersectionBarycentricsEXT(query, false))) {
                rayQueryConfirmIntersectionEXT(query);
            }
        }
    }

    vec3 colour = vec3(0.05, 0.07, 0.10);
    // Alpha carries whether anything was hit at all. Inferring it from the colour worked while the
    // output was barycentric and every hit was bright, but a material can legitimately be dark —
    // so the flag is written rather than guessed at.
    float hit = 0.0;
    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        hit = 1.0;
        // The custom index is where this instance's mesh starts in the flat geometry table, and the
        // geometry index is which of its runs was hit. Their sum is the entry, with no indirection.
        uint slot = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)
                  + rayQueryGetIntersectionGeometryIndexEXT(query, true);
        Geometry geom = geometries[slot];
        Material material = materials[geom.material];
        uint primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        float hit_t = rayQueryGetIntersectionTEXT(query, true);
        // Fetched once and shared: the texture level needs the same three vertices the shading
        // attributes come from.
        uvec3 verts = triangle_vertices(geom, primitive);

        vec3 weights = corner_weights(rayQueryGetIntersectionBarycentricsEXT(query, true));
        vec2 uv = interpolate_uv(verts, weights);
        vec3 object_normal = interpolate_normal(verts, weights);

        // The normal is interpolated in object space, so it needs the instance's own transform.
        // Morrowind scales uniformly, which is why the plain matrix works here — a non-uniform
        // scale would need the inverse transpose instead.
        mat4x3 to_world = rayQueryGetIntersectionObjectToWorldEXT(query, true);
        vec3 world_normal = normalize(mat3(to_world) * object_normal);
        vec3 position = frame.camera_position + direction * hit_t;

        vec3 albedo = material.diffuse;
        if (material.base_colour != NO_TEXTURE) {
            float lod = cone_lod(verts, to_world, direction, world_normal, hit_t,
                                 material.base_colour + 1u);
            albedo *= base_colour(material, uv, lod).rgb;
        }

        // Ambient stands in for every bounce there is no path tracer for yet.
        colour = albedo * frame.ambient;
        // Offset along the normal so the surface does not shadow itself on its own triangle. The
        // same for every light, so it is lifted out of the loop.
        vec3 shadow_origin = position + world_normal * SHADOW_BIAS;
        for (uint i = 0u; i < frame.light_count; ++i) {
            Light light = lights[i];
            vec3 to_light = light.position - position;
            float to_light_length = length(to_light);
            if (to_light_length >= light.radius) {
                continue;
            }
            vec3 L = to_light / to_light_length;
            float facing = dot(world_normal, L);
            if (facing <= 0.0) {
                continue;
            }

            // The light is a sphere, not a point, so visibility is the fraction of it that can be
            // seen rather than a yes or no. That fraction *is* the penumbra: near a blocker's edge
            // some samples reach the light and some do not, and the gradient between them is the
            // soft shadow the milestone is named for.
            float visible = 0.0;
            for (uint s = 0u; s < SHADOW_SAMPLES; ++s) {
                uint seed = hash(uvec3(pixel, i * SHADOW_SAMPLES + s));
                vec2 u = vec2(float(seed & 0xFFFFu), float((seed >> 16) & 0xFFFFu)) / 65535.0;
                vec3 target = light.position + sphere_point(u) * light.source_radius;
                vec3 offset = target - shadow_origin;
                float reach = length(offset);
                if (!occluded(shadow_origin, offset / reach, reach - SHADOW_BIAS)) {
                    visible += 1.0;
                }
            }
            if (visible == 0.0) {
                continue;
            }
            visible /= float(SHADOW_SAMPLES);
            colour += albedo * light.colour * facing
                    * attenuation(to_light_length, light.radius) * visible;
        }
        colour += material.emissive;
    }
    imageStore(target, pixel, vec4(colour, hit));
}
