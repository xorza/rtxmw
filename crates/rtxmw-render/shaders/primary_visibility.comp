#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// Primary visibility by inline ray query, with one diffuse bounce of indirect light.
//
// Ray queries in a compute shader rather than a ray tracing pipeline: there is one material path
// and no recursion here, so a shader binding table would buy nothing. The output goes to a storage
// image because a Vulkan swapchain image cannot be one — sRGB formats expose no storage capability,
// so the frame reaches the screen through a later blit.

// The pass is assembled from these, in an order the dependencies decide: nothing here may
// reference a name a later include defines, with the one exception `lighting.glsl` declares.

#include "bindings.glsl"
#include "sampling.glsl"
#include "surface.glsl"
#include "lighting.glsl"
#include "waves.glsl"
#include "water.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    // Unsigned, because the hash streams index by it and only `imageSize` and `imageStore` want it
    // signed. Carrying both would mean two names for one coordinate.
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 size = uvec2(imageSize(target));
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    // Unproject the pixel centre onto the near plane, which the matrix gives *relative to the eye*
    // — see `ndc_to_world_offset`. Subtracting the camera position from a world-space near point
    // instead is a difference of two numbers the size of the world, and it cost 116 pixels of aim
    // at Seyda Neen.
    //
    // The projection is reverse-Z, so the near plane is depth 1 and the far plane is depth 0. The
    // far plane is also at infinity, where w collapses to zero — so the near plane is the only one
    // that can be unprojected at all.
    vec2 screen_uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 near_point = frame.ndc_to_world_offset * vec4(screen_uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 direction = normalize(near_point.xyz / near_point.w);

    Surface surface = trace(frame.camera_position, direction, 0.0, frame.cone_spread, MASK_ANY);

    // A miss contributes only the sky, and writes zeroes across the G-buffer rather than leaving
    // it alone. That is not tidiness: the filter reads a neighbourhood, and an untouched pixel
    // holds whatever the last frame or the allocator left there. A zero depth is the flag it tests,
    // since a real hit is always at least `RAY_MIN` away.
    vec3 emitted = sky(direction);
    vec3 lighting = vec3(0.0);
    if (surface.water) {
        // Written whole to the output rather than through the G-buffer: there is no albedo to
        // demodulate by, and nothing noisy for the filter to improve.
        emitted = water_shade(surface, direction, pixel);
    } else if (surface.hit) {
        emitted = surface.emissive;
        lighting = gather_indirect(surface, pixel)
                 + direct_light(surface, pixel, STREAM_DIRECT, SHADOW_SAMPLES);
    }
    // Under the surface, everything the ray crossed to get here was water. The albedo is dimmed
    // rather than the lighting, because the filter divides the lighting by it and multiplying both
    // would put the water back — and what the depth took is a property of the path, not of the
    // light that travelled it.
    vec3 albedo = surface.albedo;
    if (frame.water_level - frame.camera_position.z > 0.0) {
        float path = surface.hit ? surface.t : WATER_MAX_PATH;
        emitted = absorbed_by_water(emitted, path);
        albedo *= exp(-WATER_EXTINCTION * path);
    }

    imageStore(albedo_target, ivec2(pixel), vec4(albedo, 1.0));
    imageStore(normal_depth_target, ivec2(pixel), vec4(surface.normal, surface.t));
    imageStore(illumination_target, ivec2(pixel), vec4(lighting, 1.0));
    // Alpha carries whether anything was hit at all. Inferring it from the colour worked while the
    // output was barycentric and every hit was bright, but a material can legitimately be dark —
    // so the flag is written rather than guessed at.
    imageStore(target, ivec2(pixel), vec4(emitted, surface.hit ? 1.0 : 0.0));
}
